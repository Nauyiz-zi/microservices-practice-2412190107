# Runtime profile: dev or test
APP_PROFILE=dev

# Microservice database passwords: fill real values only in local .env
W06_USER_DB_PASSWORD='CHANGE_ME_USER_APP_PASSWORD'
W06_USER_DB_ROOT_PASSWORD='CHANGE_ME_USER_ROOT_PASSWORD'

W06_TEXTBOOK_DB_PASSWORD='CHANGE_ME_TEXTBOOK_APP_PASSWORD'
W06_TEXTBOOK_DB_ROOT_PASSWORD='CHANGE_ME_TEXTBOOK_ROOT_PASSWORD'

W06_ORDER_DB_PASSWORD='CHANGE_ME_ORDER_APP_PASSWORD'
W06_ORDER_DB_ROOT_PASSWORD='CHANGE_ME_ORDER_ROOT_PASSWORD'

# Nacos server authentication
# Use a locally generated Base64-encoded random token.
NACOS_AUTH_TOKEN='CHANGE_ME_BASE64_RANDOM_TOKEN'
NACOS_AUTH_IDENTITY_KEY='CHANGE_ME_IDENTITY_KEY'
NACOS_AUTH_IDENTITY_VALUE='CHANGE_ME_IDENTITY_VALUE'

# Must match the account configured in the local Nacos instance.
NACOS_USERNAME=nacos
NACOS_PASSWORD='CHANGE_ME_NACOS_PASSWORD'

# Authentication bootstrap: BCrypt cost=12 hashes only
AUTH_ADMIN_USERNAME=demo-admin
AUTH_ADMIN_PASSWORD_HASH='CHANGE_ME_BCRYPT_COST_12_HASH'
AUTH_USER_USERNAME=demo-user
AUTH_USER_PASSWORD_HASH='CHANGE_ME_BCRYPT_COST_12_HASH'

# Legacy monolith configuration retained for earlier homework
APP_PORT=8080
MYSQL_PORT=3307
DB_NAME=campus_textbook
DB_USER=campus_app
DB_PASSWORD='CHANGE_ME_MONOLITH_APP_PASSWORD'
DB_ROOT_PASSWORD='CHANGE_ME_MONOLITH_ROOT_PASSWORD'

# Historical host-port variables; current microservices use the gateway.
W06_USER_PORT=8081
W06_TEXTBOOK_PORT=8082
W06_ORDER_PORT=8083